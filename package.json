{
  "name": "iougurt-api",
  "version": "1.0.0",
  "description": "API de gestão veterinária — Projeto IOUGURT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --out-dir dist",
    "lint": "eslint src",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:routes": "vitest run tests/integration/routes",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@brazilian-utils/brazilian-utils": "^2.3.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "@types/pdfkit": "^0.17.5",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.13",
    "fastify": "^5.12.4",
    "fastify-type-provider-zod": "^4.0.2",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.18.0",
    "resend": "^6.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "prisma": "^5.22.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "vitest-mock-extended": "^1.3.1"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
