# Database
DATABASE_URL=postgresql://iougurt:iougurt@db:5432/iougurt?schema=public

# API
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production
PASSWORD_RESET_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS: '*' libera todas as origens (default) ou lista separada por vírgula
# (ex.: https://iogurt.lablivre.rocks). Com frontend e API no mesmo domínio
# (proxy nginx), as chamadas são same-origin e o CORS nem é exercido.
CORS_ORIGIN=*

# Resend (opcional; necessario apenas para recuperacao de senha)
RESEND_API_KEY=
MAIL_FROM=
